module Straddle
  module Resources
    class Payouts
      def create: (
        amount: Integer,
        currency: String,
        description: String?,
        device: Straddle::PaymentDevice,
        external_id: String,
        paykey: String,
        payment_date: Date,
        ?config: Straddle::PayoutConfiguration,
        ?metadata: ::Hash[Symbol, String]?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def retrieve: (
        String id,
        ?correlation_id: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def update: (
        String id,
        amount: Integer,
        description: String?,
        payment_date: Date,
        ?metadata: ::Hash[Symbol, String]?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def cancel: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def hold: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def list_unmasked: (
        String id,
        ?correlation_id: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::UnmaskedPayoutResponse

      def release: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def resubmit: (
        String id,
        ?description: String?,
        ?external_id: String?,
        ?payment_date: Date?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def upload_authorization_proof: (
        String id,
        file: Straddle::Internal::file_input,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def initialize: (client: Straddle::Client) -> void
    end
  end
end
