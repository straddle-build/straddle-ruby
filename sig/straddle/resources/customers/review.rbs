module Straddle
  module Resources
    class Customers
      class Review
        def list: (
          String id,
          ?correlation_id: String,
          ?request_id: String,
          ?straddle_account_id: String,
          ?request_options: Straddle::request_opts
        ) -> Straddle::Customers::CustomerReviewResponse

        def set_verification_decision: (
          String id,
          status: Straddle::Models::Customers::ReviewSetVerificationDecisionParams::status,
          ?correlation_id: String,
          ?idempotency_key: String,
          ?request_id: String,
          ?straddle_account_id: String,
          ?request_options: Straddle::request_opts
        ) -> Straddle::CustomerResponse

        def initialize: (client: Straddle::Client) -> void
      end
    end
  end
end
