module Straddle
  module Resources
    class Charges
      def create: (
        amount: Integer,
        config: Straddle::ChargeConfiguration,
        consent_type: Straddle::Models::consent_type,
        currency: String,
        description: String?,
        device: Straddle::PaymentDevice,
        external_id: String,
        paykey: String,
        payment_date: Date,
        ?metadata: ::Hash[Symbol, String]?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def retrieve: (
        String id,
        ?correlation_id: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def update: (
        String id,
        amount: Integer,
        description: String?,
        payment_date: Date,
        ?metadata: ::Hash[Symbol, String]?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def cancel: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def hold: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def list_unmasked: (
        String id,
        ?correlation_id: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::UnmaskedChargeResponse

      def refund: (
        String id,
        ?amount: Integer?,
        ?description: String?,
        ?external_id: String?,
        ?metadata: ::Hash[Symbol, String]?,
        ?payment_date: Date?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::PayoutResponse

      def release: (
        String id,
        ?reason: String?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def resubmit: (
        String id,
        ?description: String?,
        ?external_id: String?,
        ?payment_date: Date?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def upload_authorization_proof: (
        String id,
        file: Straddle::Internal::file_input,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> Straddle::ChargeResponse

      def initialize: (client: Straddle::Client) -> void
    end
  end
end
