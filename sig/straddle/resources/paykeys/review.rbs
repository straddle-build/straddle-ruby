module Straddle
  module Resources
    class Paykeys
      class Review
        def list: (
          String id,
          ?correlation_id: String,
          ?request_id: String,
          ?straddle_account_id: String,
          ?request_options: Straddle::request_opts
        ) -> Straddle::Paykeys::PaykeyReviewResponse

        def set_verification_decision: (
          String id,
          status: Straddle::Models::Paykeys::ReviewSetVerificationDecisionParams::status,
          ?correlation_id: String,
          ?idempotency_key: String,
          ?request_id: String,
          ?straddle_account_id: String,
          ?request_options: Straddle::request_opts
        ) -> Straddle::PaykeyResponse

        def initialize: (client: Straddle::Client) -> void
      end
    end
  end
end
