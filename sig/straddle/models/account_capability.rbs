module Straddle
  module Models
    type account_capability =
      {
        capability_status: Straddle::Models::AccountCapability::capability_status
      }

    class AccountCapability < Straddle::Internal::Type::BaseModel
      attr_accessor capability_status: Straddle::Models::AccountCapability::capability_status

      def initialize: (
        capability_status: Straddle::Models::AccountCapability::capability_status
      ) -> void

      def to_hash: -> {
        capability_status: Straddle::Models::AccountCapability::capability_status
      }

      type capability_status = :active | :inactive

      module CapabilityStatus
        extend Straddle::Internal::Type::Enum

        ACTIVE: :active
        INACTIVE: :inactive

        def self?.values: -> ::Array[Straddle::Models::AccountCapability::capability_status]
      end
    end
  end
end
