module Straddle
  module Models
    type payment_status_history =
      {
        changed_at: Time,
        message: String,
        reason: Straddle::Models::payment_status_reason,
        source: Straddle::Models::payment_status_source,
        status: Straddle::Models::payment_status,
        code: String?
      }

    class PaymentStatusHistory < Straddle::Internal::Type::BaseModel
      attr_accessor changed_at: Time

      attr_accessor message: String

      attr_accessor reason: Straddle::Models::payment_status_reason

      attr_accessor source: Straddle::Models::payment_status_source

      attr_accessor status: Straddle::Models::payment_status

      attr_accessor code: String?

      def initialize: (
        changed_at: Time,
        message: String,
        reason: Straddle::Models::payment_status_reason,
        source: Straddle::Models::payment_status_source,
        status: Straddle::Models::payment_status,
        ?code: String?
      ) -> void

      def to_hash: -> {
        changed_at: Time,
        message: String,
        reason: Straddle::Models::payment_status_reason,
        source: Straddle::Models::payment_status_source,
        status: Straddle::Models::payment_status,
        code: String?
      }
    end
  end
end
