module Straddle
  module Models
    type funding_event_payment =
      {
        id: String,
        currency: String,
        external_id: String,
        funding_amount: Integer,
        payment_amount: Integer,
        payment_date: Date,
        payment_type: Straddle::Models::payment_type,
