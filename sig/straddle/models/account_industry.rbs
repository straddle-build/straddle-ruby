module Straddle
  module Models
    type account_industry = { category: String?, mcc: String?, sector: String? }

    class AccountIndustry < Straddle::Internal::Type::BaseModel
      attr_accessor category: String?

      attr_accessor mcc: String?

      attr_accessor sector: String?

      def initialize: (
        ?category: String?,
        ?mcc: String?,
        ?sector: String?
      ) -> void

      def to_hash: -> { category: String?, mcc: String?, sector: String? }
    end
  end
end
