module Straddle
  module Models
    type payout_create_params =
      {
        amount: Integer,
        currency: String,
        description: String?,
        device: Straddle::PaymentDevice,
        external_id: String,
        paykey: String,
        payment_date: Date,
        config: Straddle::PayoutConfiguration,
        metadata: ::Hash[Symbol, String]?,
        correlation_id: String,
        idempotency_key: String,
        request_id: String,
        straddle_account_id: String
      }
      & Straddle::Internal::Type::request_parameters

    class PayoutCreateParams < Straddle::Internal::Type::BaseModel
      extend Straddle::Internal::Type::RequestParameters::Converter
      include Straddle::Internal::Type::RequestParameters

      attr_accessor amount: Integer

      attr_accessor currency: String

      attr_accessor description: String?

      attr_accessor device: Straddle::PaymentDevice

      attr_accessor external_id: String

      attr_accessor paykey: String

      attr_accessor payment_date: Date

      attr_reader config: Straddle::PayoutConfiguration?

      def config=: (
        Straddle::PayoutConfiguration
      ) -> Straddle::PayoutConfiguration

      attr_accessor metadata: ::Hash[Symbol, String]?

      attr_reader correlation_id: String?

      def correlation_id=: (String) -> String

      attr_reader idempotency_key: String?

      def idempotency_key=: (String) -> String

      attr_reader request_id: String?

      def request_id=: (String) -> String

      attr_reader straddle_account_id: String?

      def straddle_account_id=: (String) -> String

      def initialize: (
        amount: Integer,
        currency: String,
        description: String?,
        device: Straddle::PaymentDevice,
        external_id: String,
        paykey: String,
        payment_date: Date,
        ?config: Straddle::PayoutConfiguration,
        ?metadata: ::Hash[Symbol, String]?,
        ?correlation_id: String,
        ?idempotency_key: String,
        ?request_id: String,
        ?straddle_account_id: String,
        ?request_options: Straddle::request_opts
      ) -> void

      def to_hash: -> {
        amount: Integer,
        currency: String,
        description: String?,
        device: Straddle::PaymentDevice,
        external_id: String,
        paykey: String,
        payment_date: Date,
        config: Straddle::PayoutConfiguration,
        metadata: ::Hash[Symbol, String]?,
        correlation_id: String,
        idempotency_key: String,
        request_id: String,
