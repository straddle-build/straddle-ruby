module Straddle
  module Models
    module Customers
      type reputation_check =
        {
          codes: ::Array[String]?,
          decision: Straddle::Models::Customers::verification_decision,
          insights: Straddle::Customers::ReputationInsights,
          risk_score: Float?
        }

      class ReputationCheck < Straddle::Internal::Type::BaseModel
        attr_accessor codes: ::Array[String]?

        attr_reader decision: Straddle::Models::Customers::verification_decision?

        def decision=: (
          Straddle::Models::Customers::verification_decision
        ) -> Straddle::Models::Customers::verification_decision

        attr_reader insights: Straddle::Customers::ReputationInsights?

        def insights=: (
          Straddle::Customers::ReputationInsights
        ) -> Straddle::Customers::ReputationInsights

        attr_accessor risk_score: Float?

        def initialize: (
          ?codes: ::Array[String]?,
          ?decision: Straddle::Models::Customers::verification_decision,
          ?insights: Straddle::Customers::ReputationInsights,
          ?risk_score: Float?
        ) -> void

        def to_hash: -> {
          codes: ::Array[String]?,
          decision: Straddle::Models::Customers::verification_decision,
          insights: Straddle::Customers::ReputationInsights,
          risk_score: Float?
        }
      end
    end
  end
end
