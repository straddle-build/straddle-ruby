module Straddle
  module Models
    type paykey_summary =
      {
        id: String,
        config: Straddle::PaykeyConfiguration,
        created_at: Time,
        label: String,
        paykey: String,
        source: Straddle::Models::paykey_source,
        status: Straddle::Models::paykey_status,
        updated_at: Time,
        bank_data: Straddle::PaykeyBankDetails,
        customer_id: String?,
        expires_at: Time?,
        external_id: String?,
        institution_name: String?,
        status_details: Straddle::PaymentStatusDetails,
        unblock_eligible: bool?
      }

    class PaykeySummary < Straddle::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor config: Straddle::PaykeyConfiguration

      attr_accessor created_at: Time

      attr_accessor label: String

      attr_accessor paykey: String

      attr_accessor source: Straddle::Models::paykey_source

      attr_accessor status: Straddle::Models::paykey_status

      attr_accessor updated_at: Time

      attr_reader bank_data: Straddle::PaykeyBankDetails?

      def bank_data=: (
        Straddle::PaykeyBankDetails
      ) -> Straddle::PaykeyBankDetails

      attr_accessor customer_id: String?

      attr_accessor expires_at: Time?

      attr_accessor external_id: String?

      attr_accessor institution_name: String?

      attr_reader status_details: Straddle::PaymentStatusDetails?

      def status_details=: (
        Straddle::PaymentStatusDetails
      ) -> Straddle::PaymentStatusDetails

      attr_accessor unblock_eligible: bool?

      def initialize: (
        id: String,
        config: Straddle::PaykeyConfiguration,
        created_at: Time,
        label: String,
        paykey: String,
        source: Straddle::Models::paykey_source,
        status: Straddle::Models::paykey_status,
        updated_at: Time,
        ?bank_data: Straddle::PaykeyBankDetails,
        ?customer_id: String?,
        ?expires_at: Time?,
        ?external_id: String?,
        ?institution_name: String?,
        ?status_details: Straddle::PaymentStatusDetails,
        ?unblock_eligible: bool?
      ) -> void

      def to_hash: -> {
        id: String,
        config: Straddle::PaykeyConfiguration,
        created_at: Time,
        label: String,
        paykey: String,
        source: Straddle::Models::paykey_source,
        status: Straddle::Models::paykey_status,
        updated_at: Time,
        bank_data: Straddle::PaykeyBankDetails,
        customer_id: String?,
        expires_at: Time?,
        external_id: String?,
        institution_name: String?,
        status_details: Straddle::PaymentStatusDetails,
        unblock_eligible: bool?
      }
    end
  end
end
